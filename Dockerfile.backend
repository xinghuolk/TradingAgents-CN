# Backend Dockerfile for FastAPI service (TradingAgents-CN v1.0.0-preview)
# 前后端分离架构 - 后端服务
# 支持多架构: amd64, arm64

# 使用 Debian Bookworm (稳定版) 而不是 Trixie (测试版)
FROM python:3.11-slim-bookworm

ARG DEBIAN_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
ARG DEBIAN_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian-security
ARG PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# GitHub 代理：默认直连 GitHub（rev 已 pin，tarball 由 GitHub 内容寻址保证）。
# 第三方代理（如 gh-proxy.com）返回的可执行字节不经哈希/签名校验，故仅 opt-in：
# 需要时显式 --build-arg GITHUB_PROXY=https://gh-proxy.com/
ARG GITHUB_PROXY=
# financial-report-llm-extractor 的 git rev。优先由 compose 的 build.args 注入
# （可在 .env 设 FINANCIAL_REPORT_EXTRACTOR_REV 覆盖）；此处默认仅作 docker build 直接
# 构建（不经 compose）时的回退值。
ARG FINANCIAL_REPORT_EXTRACTOR_REV=e7c7d2d34e9253f33ac4a398bf56e9298dd47938

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai

WORKDIR /app

# 创建必需的目录并安装系统依赖
# - curl: 健康检查
# - pandoc/wkhtmltopdf: 从 Debian 国内镜像安装，避免 Docker 构建访问 GitHub Release
# - 中文字体: 用于 PDF 中文显示
RUN mkdir -p /app/logs /app/data /app/config && \
    # 切换 Debian apt 源到国内镜像
    sed -i \
        -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
        -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
        /etc/apt/sources.list.d/debian.sources && \
    # 配置 apt 重试和超时
    echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::http::Timeout "30";' >> /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::https::Timeout "30";' >> /etc/apt/apt.conf.d/80-retries && \
    # 更新软件源，允许失败后继续
    (apt-get update || apt-get update || apt-get update) && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fontconfig \
        fonts-noto-cjk \
        git \
        pandoc \
        wkhtmltopdf \
        xvfb && \
    # 更新字体缓存
    fc-cache -fv && \
    rm -rf /var/lib/apt/lists/*

# 复制pyproject.toml和README.md（pip安装需要）
COPY pyproject.toml README.md ./

# 安装Python依赖
# 优化说明：
# 1. 使用清华镜像加速下载
# 2. 优先使用预编译的二进制wheel包（--prefer-binary）
# 3. 避免从源码编译，大幅提升ARM架构构建速度
# 4. 显式安装 GitHub pin 的 financial-report-llm-extractor；pip 不读取 [tool.uv.sources]，默认走 GitHub 代理
# 5. 安装 PDF 导出工具: pdfkit
RUN pip install --upgrade pip -i "${PYPI_INDEX_URL}" && \
    pip install --prefer-binary "${GITHUB_PROXY}https://github.com/xinghuolk/financial-report-llm-extractor/archive/${FINANCIAL_REPORT_EXTRACTOR_REV}.tar.gz" -i "${PYPI_INDEX_URL}" && \
    pip install --prefer-binary . -i "${PYPI_INDEX_URL}" && \
    pip install --prefer-binary pdfkit -i "${PYPI_INDEX_URL}"

# 复制后端代码和必需模块
COPY app ./app
COPY tradingagents ./tradingagents
COPY config ./config
COPY scripts ./scripts
COPY docs ./docs
COPY install ./install

# 复制Docker环境配置文件
COPY .env.docker ./.env

# 暴露后端端口（与docker-compose.v1.0.0.yml一致）
EXPOSE 8000

# Docker环境标识
ENV DOCKER_CONTAINER=true

# 启动FastAPI服务
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
